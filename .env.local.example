# Neon Postgres connection string (Neon Dashboard > Connection Details)
DATABASE_URL="postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# Auth.js (NextAuth) - tạo secret ngẫu nhiên bằng: npx auth secret
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
